# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./dailyuswire.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dailyuswire

# ---- URLs ----
SITE_URL=https://dailyuswire.com
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://dailyuswire.com

# ---- First admin user (created on first run) ----
ADMIN_EMAIL=admin@dailyuswire.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Site Admin

# ---- Outgoing mail (Forgot password) ----
# Leave SMTP_HOST blank to send through the server's sendmail (works on cPanel).
# Set these if reset emails land in spam or never arrive, e.g. a cPanel mailbox:
# SMTP_HOST=mail.dailyuswire.com
# SMTP_PORT=465
# SMTP_USER=no-reply@dailyuswire.com
# SMTP_PASSWORD=mailbox-password
# MAIL_FROM=Daily US Wire <no-reply@dailyuswire.com>

# ---- Uploads ----
MEDIA_DIR=./media
MAX_UPLOAD_MB=10

# ---- Frontend revalidation webhook (ISR) ----
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-too

# ---- Editor ----
# TinyMCE is self-hosted (GPL) - no API key needed.
