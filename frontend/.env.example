# Public base URL of the site (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://dailyuswire.com

# FastAPI backend, reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side backend URL (use the internal address in Docker/Kubernetes)
API_INTERNAL_URL=http://localhost:8000

# Must match backend REVALIDATE_SECRET
REVALIDATE_SECRET=change-me-too

# Google AdSense publisher id, e.g. ca-pub-1234567890123456 (leave blank to disable)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code
NEXT_PUBLIC_GSC_VERIFICATION=
